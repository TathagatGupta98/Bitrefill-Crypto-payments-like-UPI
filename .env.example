PORT=3000
PUBLIC_URL=https://your-static-domain.ngrok-free.app
BITREFILL_API_KEY=
BITREFILL_BASE_URL=https://api.bitrefill.com/v2
BITREFILL_TEST_MODE=true            # true -> test-gift-card-code, free
BITREFILL_TEST_PRODUCT=test-gift-card-code   # test-gift-card-code-fail demos a failed purchase
PHONEPE_PRODUCT_ID=phonepe-india    # verify with scripts/find-product.js
TELEGRAM_BOT_TOKEN=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
BASE_RPC_URL=https://base-rpc.publicnode.com   # mainnet.base.org answers eth_getLogs with 429
RECEIVE_ADDRESS=0x...
USDC_BASE_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
INR_PER_USD=88                      # fallback FX if Bitrefill gives no USD price; set to today's rate
MARKUP_PCT=3
SALE_TTL_MIN=15
DEFAULT_PER_SALE_CAP_INR=500
DEFAULT_DAILY_CAP_INR=2000
AGENT_MAX_PER_PURCHASE_USD=60
AGENT_MAX_DAILY_USD=10
BALANCE_FLOOR_USD=2
DEV_MODE=true                       # enables "simulate payment" endpoint/button
PAY_MODE=relay                      # direct -> customer pays the Bitrefill invoice in real USDC; needs BITREFILL_TEST_MODE=false
